<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panelRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="12dp"
    android:elevation="10dp"
    android:backgroundTint="#CC000000"
    android:radius="20dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- First row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/buttonHome"
                style="@style/PanelItem" >
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:tint="@android:color/white"
                    android:src="@drawable/ic_home" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:text="Home" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/buttonBack"
                style="@style/PanelItem" >
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:tint="@android:color/white"
                    android:src="@drawable/ic_back" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:text="Back" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/buttonRecents"
                style="@style/PanelItem" >
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:tint="@android:color/white"
                    android:src="@drawable/ic_recents" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:text="Apps" />
            </LinearLayout>
        </LinearLayout>

        <!-- Second row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:id="@+id/buttonLock"
                style="@style/PanelItem" >
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:tint="@android:color/white"
                    android:src="@drawable/ic_lock" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:text="Lock" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/buttonScreenshot"
                style="@style/PanelItem" >
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:tint="@android:color/white"
                    android:src="@drawable/ic_screenshot" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:text="Shot" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/buttonFlashlight"
                style="@style/PanelItem" >
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:tint="@android:color/white"
                    android:src="@drawable/ic_flashlight" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:text="Torch" />
            </LinearLayout>
        </LinearLayout>

        <!-- Third row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:id="@+id/buttonNotifications"
                style="@style/PanelItem" >
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:tint="@android:color/white"
                    android:src="@drawable/ic_notifications" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:text="Notif" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/buttonWifi"
                style="@style/PanelItem" >
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:tint="@android:color/white"
                    android:src="@drawable/ic_wifi" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:text="Wi‑Fi" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/buttonBluetooth"
                style="@style/PanelItem" >
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:tint="@android:color/white"
                    android:src="@drawable/ic_bluetooth" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:text="BT" />
            </LinearLayout>

        </LinearLayout>

        <!-- Bottom row: volume slider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <SeekBar
                android:id="@+id/volumeSlider"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:max="100"
                android:progressTint="@color/teal_200"
                android:thumbTint="@color/teal_200" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>



