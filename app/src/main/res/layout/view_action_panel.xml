<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/panelRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="12dp"
    android:elevation="10dp"
    android:backgroundTint="#E0212121"
    android:radius="20dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- First row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <LinearLayout
                android:id="@+id/buttonHome"
                style="@style/PanelItem"
                android:layout_width="0dp"
                android:layout_weight="1">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:tint="?attr/colorOnSurface"
                    android:src="@drawable/ic_home_modern" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/buttonBack"
                style="@style/PanelItem"
                android:layout_width="0dp"
                android:layout_weight="1">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:tint="?attr/colorOnSurface"
                    android:src="@drawable/ic_back_modern" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/buttonRecents"
                style="@style/PanelItem"
                android:layout_width="0dp"
                android:layout_weight="1">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:tint="?attr/colorOnSurface"
                    android:src="@drawable/ic_apps_modern" />
            </LinearLayout>
        </LinearLayout>

        <!-- Second row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:id="@+id/buttonLock"
                style="@style/PanelItem"
                android:layout_width="0dp"
                android:layout_weight="1">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:tint="?attr/colorOnSurface"
                    android:src="@drawable/ic_lock_modern" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/buttonScreenshot"
                style="@style/PanelItem"
                android:layout_width="0dp"
                android:layout_weight="1">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:tint="?attr/colorOnSurface"
                    android:src="@drawable/ic_screenshot_modern" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/buttonFlashlight"
                style="@style/PanelItem"
                android:layout_width="0dp"
                android:layout_weight="1">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:tint="?attr/colorOnSurface"
                    android:src="@drawable/ic_torch_modern" />
            </LinearLayout>
        </LinearLayout>

        <!-- Third row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:id="@+id/buttonNotifications"
                style="@style/PanelItem"
                android:layout_width="0dp"
                android:layout_weight="1">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:tint="?attr/colorOnSurface"
                    android:src="@drawable/ic_bell_modern" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/buttonWifi"
                style="@style/PanelItem"
                android:layout_width="0dp"
                android:layout_weight="1">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:tint="?attr/colorOnSurface"
                    android:src="@drawable/ic_wifi_modern" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/buttonBluetooth"
                style="@style/PanelItem"
                android:layout_width="0dp"
                android:layout_weight="1">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:tint="?attr/colorOnSurface"
                    android:src="@drawable/ic_bluetooth_modern" />
            </LinearLayout>

        </LinearLayout>

        <!-- Bottom row: volume slider -->
        <LinearLayout
            android:layout_width="260dp"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_volume_pill"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:id="@+id/iconVolumeDown"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:tint="?attr/colorOnSurface"
                    android:src="@drawable/ic_speaker_modern" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/volumeSlider"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/iconVolumeUp"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:tint="?attr/colorOnSurface"
                    android:src="@drawable/ic_speaker_modern" />
            </LinearLayout>
        </LinearLayout>

        <!-- Brightness slider -->
        <LinearLayout
            android:layout_width="260dp"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_volume_pill"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:id="@+id/iconBrightnessLow"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:tint="?attr/colorOnSurface"
                    android:src="@drawable/ic_sun_modern" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/brightnessSlider"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/iconBrightnessHigh"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:tint="?attr/colorOnSurface"
                    android:src="@drawable/ic_sun_modern" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>



